{
  "name": "quantamason-payment-acceptance-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Configurable TypeScript acceptance harness for Solana checkout, webhook, and exactly-once fulfillment boundaries.",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "demo": "npm run build && node dist/src/demo.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
